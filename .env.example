# Copy to .env.local for local development, and set the same names in
# Vercel → Settings → Environment Variables for production.
# Full guide: docs/reservas-backend.md

# 1) Email to the company (https://resend.com → API Keys)
RESEND_API_KEY=
# One or more addresses, comma-separated
BOOKING_EMAIL_TO=destinostravel5eirl@gmail.com
# Leave empty until you verify your own domain in Resend; then e.g.
# BOOKING_EMAIL_FROM=Destinos Travel <reservas@tudominio.pe>
BOOKING_EMAIL_FROM=

# 2) Google Sheet (Apps Script web app URL + the SECRET you set in the script)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# 3) Confirmation email to the customer — only once your domain is verified in Resend
SEND_CUSTOMER_EMAIL=false
